    { "method": "POST", "path": "/tasks/claim",               "roles": ["runner"] },
    { "method": "POST", "path": "/tasks/claim-loom",          "roles": ["runner"] },
    { "method": "POST", "path": "/tasks/claim-fabric",        "roles": ["runner"] },
    { "method": "GET",  "path": "/tasks/abc/input",           "roles": ["runner"] },
    { "method": "POST", "path": "/tasks/abc/input",           "roles": ["dispatcher"] },
    { "method": "GET",  "path": "/tasks/abc",                 "roles": ["observer", "dispatcher", "runner", "reviewer"] },
