    { "method": "GET",  "path": "/admin/binaries/hub",        "roles": ["dispatcher", "reviewer"] },
    { "method": "GET",  "path": "/admin",                     "roles": ["reviewer"] },
    { "method": "POST", "path": "/admin/anything-else",       "roles": ["reviewer"] },

    { "method": "GET",  "path": "/secrets",                   "roles": ["reviewer"] },
    { "method": "POST", "path": "/secrets/name",              "roles": ["reviewer"] },

    { "method": "GET",  "path": "/labels",                    "roles": ["observer", "reviewer"] },
    { "method": "POST", "path": "/labels",                    "roles": ["reviewer"] },
    { "method": "GET",  "path": "/labels/x",                  "roles": ["reviewer"] },

    { "method": "GET",  "path": "/policy",                    "roles": ["observer", "reviewer"] },
    { "method": "GET",  "path": "/history/status",            "roles": ["observer", "reviewer"] },
    { "method": "POST", "path": "/hosts/roles",               "roles": ["runner", "dispatcher", "reviewer"] },

    { "method": "GET",  "path": "/tasks",                     "roles": ["observer", "dispatcher", "runner", "reviewer"] },
    { "method": "POST", "path": "/tasks",                     "roles": ["dispatcher"] },
    { "method": "GET",  "path": "/tasks/v2",                  "roles": ["observer", "dispatcher", "runner", "reviewer"] },
    { "method": "POST", "path": "/tasks/v2",                  "roles": ["dispatcher"] },
